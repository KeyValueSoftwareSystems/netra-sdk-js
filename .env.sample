NETRA_APP_NAME=
NETRA_ENV=
NETRA_OTLP_ENDPOINT=

NETRA_API_KEY=

NETRA_TRACE_CONTENT=
NETRA_DISABLE_BATCH=

# Debug Mode
NETRA_DEBUG=

# Scrubbing Configuration
NETRA_ENABLE_SCRUBBING=

# Resource Attributes (JSON format)
# NETRA_RESOURCE_ATTRS={"version":"1.0.0","team":"engineering"}

# Blocked Spans (comma-separated span name patterns)
# NETRA_BLOCKED_SPANS=health-check,metrics

# Attribute Limits
NETRA_ATTRIBUTE_MAX_LEN=
NETRA_CONVERSATION_CONTENT_MAX_LEN=

# OTEL_SERVICE_NAME=smpleService
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer token
# OTEL_RESOURCE_ATTRIBUTES=
# LLM Provider API Keys (for testing/integration)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=

# Red-team SDK (Netra.redteam) — beta
# Ordinary REST timeout (seconds) for every red-team API call (default: 20)
NETRA_REDTEAM_TIMEOUT=
# Interval (seconds) between createRun retries while prompts are still generating (default: 2)
NETRA_REDTEAM_GENERATION_POLL_INTERVAL=
# Deadline (seconds) to wait for prompt generation before failing (default: 300)
NETRA_REDTEAM_GENERATION_TIMEOUT=
