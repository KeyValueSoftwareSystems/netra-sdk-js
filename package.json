{
  "name": "netra-sdk",
  "version": "1.5.0",
  "description": "A comprehensive TypeScript/JavaScript SDK for AI application observability built on top of OpenTelemetry and Traceloop",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start:dev": "tsup --watch",
    "prepack": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "netra",
    "tracing",
    "observability",
    "sdk",
    "ai",
    "llm",
    "opentelemetry",
    "traceloop",
    "typescript",
    "javascript"
  ],
  "author": "KeyValue Software Systems",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeyValueSoftwareSystems/netra-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/KeyValueSoftwareSystems/netra-sdk-js/issues"
  },
  "homepage": "https://github.com/KeyValueSoftwareSystems/netra-sdk-js#readme",
